FIE_PORT=17879
FIE_HOST=127.0.0.1
FIE_DB_PATH=./data/fie.sqlite
FIE_PRIVACY_MODE=summary
FIE_LOG_PATH=./logs/fie.jsonl

# 决策双阈值与生命周期（可选，留空用默认值）
# 最高候选分数 >= FIE_T_MATCH 高置信 check_in；
# FIE_T_CREATE <= 分 < FIE_T_MATCH 归入最高候选并标低置信；
# < FIE_T_CREATE 才新建 Focus。
FIE_T_MATCH=50
FIE_T_CREATE=25
# 超过该天数无 check-in 的 active Focus 可被 sweep 置为 dormant
FIE_DORMANT_DAYS=30
